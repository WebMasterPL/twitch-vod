# Skopiuj do .env i uzupelnij. Plik .env jest w .gitignore.
# Wartosci EXPO_PUBLIC_* sa wkompilowane w bundle - traktuj je jak publiczne.

# Client ID z https://dev.twitch.tv/console/apps
EXPO_PUBLIC_TWITCH_CLIENT_ID=

# Adres strony-pomostu na GitHub Pages (repo twitchvod-auth).
# To jest redirect_uri wysylany do Twitcha - musi byc HTTPS, bo konsola
# Twitcha odrzuca custom scheme. Wpisz DOKLADNIE ten sam adres w Twitch
# Developer Console, razem z ukosnikiem na koncu.
EXPO_PUBLIC_AUTH_BRIDGE_URL=https://TWOJ-LOGIN.github.io/twitchvod-auth/

# Powrot ze strony-pomostu do aplikacji (twitchvod://auth) NIE jest
# konfigurowalny - to stala APP_CALLBACK_URL w src/auth/config.ts.
